# Zendesk READ-ONLY source account credentials
# Copy this file to config/source.env and fill in the blanks
#
# Choose ONE auth method:

# --- Method 1: Email + API Token (Basic Auth) ---
# ZENDESK_SUBDOMAIN=your-source-subdomain
# ZENDESK_EMAIL=agent@example.com
# ZENDESK_API_TOKEN=your_api_token_here

# --- Method 2: OAuth Bearer Token ---
# ZENDESK_SUBDOMAIN=your-source-subdomain
# ZENDESK_OAUTH_TOKEN=your_oauth_token_here

# Run `python main.py pre-flight` to verify after setup.
