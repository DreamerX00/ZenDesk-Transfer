# Zendesk TARGET account credentials (receives migrated config)
# Copy this file to config/target.env and fill in the blanks
#
# Choose ONE auth method:

# --- Method 1: Email + API Token (Basic Auth) ---
# ZENDESK_SUBDOMAIN=your-target-subdomain
# ZENDESK_EMAIL=admin@example.com
# ZENDESK_API_TOKEN=your_api_token_here

# --- Method 2: OAuth Bearer Token (recommended with auto-refresh) ---
# ZENDESK_SUBDOMAIN=your-target-subdomain
# ZENDESK_OAUTH_TOKEN=your_oauth_token_here
# ZENDESK_OAUTH_REFRESH_TOKEN=your_refresh_token_here
# ZENDESK_CLIENT_ID=your_oauth_client_id
# ZENDESK_CLIENT_SECRET=your_oauth_client_secret

# Run `python main.py pre-flight` to verify after setup.
