# Copy this file to docker/.env and fill in the blanks before
# `docker compose up`.

# Generate with:  openssl rand -hex 32
ZDX_HMAC_SECRET=

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (urlsafe-base64 of 32 bytes; OR a 64-char hex string.)
ZDX_FERNET_KEY=

# The public URL of the backend, as the Zendesk app will reach it.
# In a single-host dev setup this is http://localhost:8080. In
# production, this is the HTTPS URL of your TLS-terminating proxy
# (Caddy / nginx / Traefik) in front of the backend.
ZDX_BACKEND_URL=http://localhost:8080

# Bind address. Default 127.0.0.1 — only localhost can reach the
# backend without a reverse proxy. Set to 0.0.0.0 only if a TLS
# proxy on the same host fronts it.
ZDX_BIND=127.0.0.1

# Comma-separated list of allowed CORS origins. Production: your
# Zendesk subdomain, e.g. https://acme.zendesk.com
ZDX_CORS_ORIGINS=https://localhost:4567,http://localhost:4567

# Standalone mode is OFF by default for safer production deployments.
# Set to 1 only if you intentionally want the bundled UI reachable
# directly at http://localhost:8080/.
ZDX_STANDALONE_MODE=0

# Optional host paths for persistent data. Defaults keep using
# repo-local directories when these are unset; in production you
# will usually want dedicated absolute paths instead.
# ZDX_STATE_DIR=/srv/zd-transfer/state
# ZDX_EXPORTS_DIR=/srv/zd-transfer/exports
# ZDX_BACKUPS_DIR=/srv/zd-transfer/backups

# Optional image tag/name if you want compose to build/tag a named
# production image instead of the default local name.
# ZDX_IMAGE_NAME=zd-transfer-backend
# ZDX_IMAGE_TAG=latest

# Optional queue/runtime tuning.
# ZDX_QUEUE_NAME=zd-transfer
# ZDX_JOB_TIMEOUT_S=21600
