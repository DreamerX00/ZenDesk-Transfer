node_modules/
ui/node_modules/
ui/dist/
ui/assets/app-*
ui/assets/asset-*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
*.orig
*.bak
*.tmp
.claude/
.codex/
.agents/
.commandcode/

# Environment files
*.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

