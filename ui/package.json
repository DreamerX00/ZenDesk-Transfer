    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@zendeskgarden/react-theming": "^9.15.5",
    "dompurify": "^3.4.7",
    "marked": "^18.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.11",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^29.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "overrides": {
    "@reach/auto-id": {
      "react": "$react",
